{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/discovery/producer-candidate.schema.json",
  "title": "Discovery producer candidate report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "week", "bundle_digest", "producer", "topics",
    "discarded_noise_notes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "week": {"type": "string", "minLength": 1},
    "bundle_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "run_id"],
      "properties": {
        "kind": {"const": "ide_coding_agent"},
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "run_id": {"type": "string", "maxLength": 100}
      }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "title", "summary", "who", "pain_class", "signal_strength",
          "evidence"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 80},
          "title": {"type": "string", "minLength": 1, "maxLength": 200},
          "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
          "who": {"type": "string", "minLength": 1, "maxLength": 500},
          "pain_class": {
            "enum": ["hair_on_fire", "important", "nice_to_solve", "opportunity"]
          },
          "signal_strength": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["post_key", "quote"],
              "properties": {
                "post_key": {"type": "string", "minLength": 1, "maxLength": 200},
                "quote": {"type": "string", "minLength": 1, "maxLength": 500}
              }
            }
          }
        }
      }
    },
    "discarded_noise_notes": {"type": "string", "maxLength": 2000}
  }
}
