# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: override default models (see board/config.py)
# CHAIRMAN_MODEL=anthropic/claude-opus-4
# COUNCIL_MODELS=anthropic/claude-sonnet-4,google/gemini-2.5-pro,openai/gpt-4.1

# Native provider SDK keys. Existing OpenRouter model IDs still work.
# Use model prefixes to route natively:
# - glm/glm-5.1 or zai/glm-5.1       -> Z.AI SDK
# - qwen/qwen3-max or qwen/qwen-plus -> DashScope SDK
# - deepseek/deepseek-chat           -> DeepSeek via OpenAI SDK
# - kimi/kimi-k2.5                   -> Kimi via OpenAI SDK
# Prefix with openrouter: to force OpenRouter, for example:
# CHAIRMAN_MODEL=openrouter:anthropic/claude-opus-4
# ZAI_API_KEY=...
# DASHSCOPE_API_KEY=...
# DASHSCOPE_REGION=international
# DEEPSEEK_API_KEY=...
# MOONSHOT_API_KEY=...
