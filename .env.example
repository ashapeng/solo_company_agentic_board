# Native provider SDK keys used by the default model configuration.
DEEPSEEK_API_KEY=your-deepseek-key-here
MOONSHOT_API_KEY=your-moonshot-key-here
GEMINI_API_KEY=your-gemini-key-here
ZAI_API_KEY=your-zai-key-here
DASHSCOPE_API_KEY=your-dashscope-key-here
DASHSCOPE_REGION=international       # required for Qwen free quota; cn has no free tier
# (GOOGLE_API_KEY is also accepted as a fallback; if both are set,
# GEMINI_API_KEY wins.)

# Optional API hardening for non-local deployments.
# Remote access stays disabled unless AGENTIC_BOARD_ALLOW_REMOTE=1.
# If remote access is enabled, every non-local request must send:
# Authorization: Bearer <AGENTIC_BOARD_REMOTE_TOKEN>
# AGENTIC_BOARD_ALLOW_REMOTE=0
# AGENTIC_BOARD_REMOTE_TOKEN=your-long-random-token
# AGENTIC_BOARD_WEB_SEARCH_RATE_LIMIT=20
# AGENTIC_BOARD_WEB_SEARCH_RATE_WINDOW_SECONDS=60

# Optional: override default models (see board/config.py)
# CHAIRMAN_MODEL=kimi/kimi-k2.6
# COUNCIL_MODELS=deepseek/deepseek-v4-pro,glm/glm-5.1,qwen/qwen3.6-max-preview
# CLASSIFIER_MODEL=gemini/gemini-2.5-flash
# RECOMMENDED: keep verifier off DeepSeek-v4-pro. v4-pro's reasoning consumes
# the verifier's max_tokens budget and returns empty content, so verification
# silently fails (see baseline diagnosis 2026-05-16). Qwen emits parseable JSON.
VERIFICATION_MODEL=qwen/qwen3.6-max-preview

# Use model prefixes to route natively:
# - gemini/gemini-2.5-flash      -> google-genai SDK (free tier)
# - glm/glm-4.6 or zai/glm-4.6   -> Z.AI SDK
# - qwen/qwen-flash              -> DashScope native SDK
# - deepseek/deepseek-chat       -> DeepSeek via OpenAI SDK (api.deepseek.com/v1)
# - kimi/kimi-k2.6 (or moonshot/) -> Moonshot via OpenAI SDK (api.moonshot.ai/v1)

# Optional base-URL overrides:
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# DASHSCOPE_BASE_URL=

# Optional thinking-mode toggles:
# ZAI_THINKING=enabled
# QWEN_THINKING=true
# QWEN_THINKING_BUDGET=512
# RECOMMENDED: leave Kimi thinking OFF for the chair. K2.6 with thinking enabled
# routes most output tokens through reasoning_content, leaving stage3.content
# empty 80%+ of the time (see baseline diagnosis 2026-05-16).
KIMI_THINKING=0

# Per-provider reasoning controls (all optional)
# RECOMMENDED: keep DeepSeek-v4-pro reasoning low. Council members on v4-pro
# at default ("high") often emit 0 chars when the reasoning budget fills.
DEEPSEEK_REASONING_EFFORT=low           # one of: low|medium|high|max — only for deepseek-v4-* models
# GEMINI_THINKING_BUDGET=-1                # gemini-2.5-*: -1 = dynamic, 0 = disable, 1..32k = explicit cap
# GEMINI_THINKING_LEVEL=high               # gemini-3-*: minimal|low|medium|high
# QWEN_PRESERVE_THINKING=true              # qwen3.6-*: preserve thinking traces across multi-turn calls

# Optional OpenRouter escape hatch. ONLY used when a model id starts with
# 'openrouter:' — never the implicit default. Example:
#   CHAIRMAN_MODEL=openrouter:anthropic/claude-opus-4
# OPENROUTER_API_KEY=your-openrouter-api-key

# AGENTIC_BOARD_ALLOW_SAME_VERIFIER=1
# AGENTIC_BOARD_SHADOW_DISABLED=1

# AGENTIC_BOARD_DRIFT_SCORE_DELTA=-0.5
# AGENTIC_BOARD_DRIFT_JS=0.3

# ── Web search / browser tool ─────────────────────────────────
# Tavily search provider key (used by web_search and as open_browser fallback).
# TAVILY_API_KEY=

# Browser tool mode: chrome (default, drives local Chrome via Playwright) | tavily | disabled.
# AGENTIC_BOARD_BROWSER=chrome

# Run Chrome headed (1, default) or headless (0). Set to 0 in WSL/CI without an X server.
# AGENTIC_BOARD_BROWSER_HEADED=1

# Override the Chrome user-data dir. Defaults to per-OS standard paths.
# AGENTIC_BOARD_CHROME_USER_DATA_DIR=

# ── Live research script ──────────────────────────────────────
# Model used for the secretary brief in live_research script. Default avoids
# the chair's reasoning model (which emits empty content under thinking mode).
# AGENTIC_BOARD_LIVE_SECRETARY_MODEL=qwen/qwen3.6-max-preview

# Max turns the existing live runtime will play before idling.
# AGENTIC_BOARD_LIVE_MAX_TURNS=12

# ── Tool: validate_claim ──────────────────────────────────────
# Judge model for the validate_claim tool (web_search + LLM verdict).
# Defaults to a fast/cheap model.
# VALIDATE_CLAIM_MODEL=gemini/gemini-2.5-flash
